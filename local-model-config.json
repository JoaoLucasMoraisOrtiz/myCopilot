{
  "phi-local": {
    "id": "phi-local",
    "name": "Phi Local (OpenAI-compatible)",
    "api": "http://localhost:8000/v1",
    "env": ["PHI_LOCAL_API_KEY"],
    "npm": "@ai-sdk/openai-compatible",
    "models": {
      "Phi-3-mini-128k-instruct-qnn-npu:1": {
        "id": "Phi-3-mini-128k-instruct-qnn-npu:1",
        "name": "Phi-3 Mini 128k Instruct (QNN NPU)",
        "release_date": "2024-04-23",
        "attachment": false,
        "reasoning": false,
        "temperature": true,
        "tool_call": true,
        "cost": { "input": 0, "output": 0 },
        "limit": { "context": 4096, "output": 2048 },
        "modalities": { "input": ["text"], "output": ["text"] },
        "options": {
          "timeout": 300000,
          "keepAlive": true
        },
        "headers": {
          "Connection": "keep-alive"
        }
      }
    }
  }
}